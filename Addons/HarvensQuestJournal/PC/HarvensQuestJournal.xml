<GuiXml>
	<Controls>
		<TopLevelControl name="HarvensQuestJournalTopLevel" allowBringToTop="false" mouseEnabled="true" hidden="true">
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" />
			<Anchor point="BOTTOMRIGHT" relativeTo="GuiRoot" offsetY="-55"/>

			<OnMouseUp>
				if upInside then
				HARVENS_QUEST_JOURNAL:OnPageClicked(self, button)
				end
			</OnMouseUp>
			<Controls>
				<Control name="$(parent)Journal">
					<Dimensions x="1024" y="1024"/>
					<Anchor point="CENTER" offsetY="-20" />

					<Controls>
						<Texture name="$(parent)Bg" textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES">
							<Dimensions x="1024" y="1024"/>
							<Anchor point="CENTER" />
						</Texture>

						<Scroll name="$(parent)LeftPage">
							<OnInitialized>
								self:SetScrollBounding(SCROLL_BOUNDING_UNBOUND)
							</OnInitialized>

							<Controls>
								<Control name="$(parent)Container" resizeToFitDescendents="true">
									<Anchor point="TOPLEFT" />

									<Controls>
										<Label name="$(parent)Title" horizontalAlignment="CENTER" font="ZoFontBookPaperTitle">
											<Anchor point="TOPLEFT" />
										</Label>
										<Label name="$(parent)Body" mouseEnabled="true" font="ZoFontBookPaper" linkEnabled="true">
											<Anchor point="TOP" relativeTo="$(parent)Title" relativePoint="BOTTOM" />
										</Label>
									</Controls>
								</Control>
							</Controls>
						</Scroll>

						<Scroll name="$(parent)RightPage">
							<OnInitialized>
								self:SetScrollBounding(SCROLL_BOUNDING_UNBOUND)
							</OnInitialized>

							<Controls>
								<Control name="$(parent)Container" resizeToFitDescendents="true">
									<Anchor point="TOPLEFT" />
									<Controls>
										<Label name="$(parent)Body" mouseEnabled="true" font="ZoFontBookPaper" linkEnabled="true">
											<Anchor point="TOPLEFT" />
										</Label>
									</Controls>
								</Control>
							</Controls>
						</Scroll>
					</Controls>
				</Control>
				<Control name="$(parent)KeyStripMouseButtons">
					<Dimensions x="98" y="54"/>
					<Controls>
						<Texture name="$(parent)PreviousPage" mouseEnabled="true" textureFile="EsoUI/Art/Miscellaneous/icon_LMB.dds">
							<Dimensions x="52" y="52"/>
							<Anchor point="TOPLEFT"/>
						</Texture>
						<Texture name="$(parent)NextPage" mouseEnabled="true" textureFile="EsoUI/Art/Miscellaneous/icon_RMB.dds">
							<Dimensions x="52" y="52"/>
							<Anchor point="TOPLEFT" relativeTo="$(parent)PreviousPage" relativePoint="TOPRIGHT" offsetX="-10"/>
						</Texture>
					</Controls>
				</Control>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>